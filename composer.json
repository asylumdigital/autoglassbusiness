{
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "asylum/theme": {
            "type": "vcs",
            "url": "git@github.com:asylumdigital/wp-theme-core.git"
        },
        "asylum/updater": {
            "type": "vcs",
            "url": "git@github.com:philsbury/asylum-updater.git"
        },
        "asylum/utility": {
            "type": "vcs",
            "url": "git@github.com:asylumdigital/asylum-utility.git"
        },
        "asylum/config": {
            "type": "vcs",
            "url": "git@github.com:asylumdigital/asylum-config.git"
        },
        "asylum/block": {
            "type": "vcs",
            "url": "git@github.com:asylumdigital/asylum-block.git"
        },
        "asylum/validation": {
            "type": "vcs",
            "url": "git@github.com:asylumdigital/validation.git"
        }

    },
    "require": {
        "asylum/theme": "^6.1.1",
        "stoutlogic/acf-builder": "^1.12",
        "illuminate/collections": "^12.20",
        "vlucas/phpdotenv": "5.4"
    },
    "autoload": {
        "psr-4": {
            "Asylum\\Theme\\": "app"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "touch .env"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "require-dev": {
        "php-stubs/acf-pro-stubs": "^6.8"
    }
}
