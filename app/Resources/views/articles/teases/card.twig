<article class="h-full bg-default text-white hover:shadow-lg transition-all hover:-translate-y-1">
    <a href="{{ post.link }}" title="Read more" class="flex flex-col gap-1.5 h-full group">

        <div class="aspect-video w-full overflow-hidden lg:clip-video">
            {% if post.thumbnail.src %}
                {{ dump(post.thumbnail.aspect) }}
                <img src="{{ post.thumbnail.src }}" width="{{ post.thumbnail.width }}" height="{{ post.thumbnail.height }}" alt="{{ post.thumbnail.alt }}" loading="lazy" class="w-full h-full object-cover" />
            {% else %}
                <div class="w-full h-full object-cover bg-highlight"></div>
            {% endif %}
        </div>

        <div class="p-5 flex flex-col gap-4 flex-1">
            <h2 class="line-clamp-2">{{ post.title }}</h2>

            <p class="line-clamp-2">{{ post.excerpt.read_more(false) }}</p>

            <p class="group-hover:opacity-100 flex font-bold items-center gap-1.5 mt-auto ml-auto opacity-0 text-tertiary">
                <span class="sr-only">Read more</span>
                <span class="w-2.5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 11 9"><path fill="currentColor" d="M5.462 4.833c.246-.246.246-.656 0-.93L1.743.185c-.273-.247-.683-.247-.93 0L.185.813c-.247.274-.247.684 0 .93l2.652 2.652L.185 7.02c-.247.247-.247.657 0 .93l.628.602c.247.273.657.273.93 0zm5.25-.93L6.993.185c-.273-.247-.683-.247-.93 0l-.628.628a.68.68 0 0 0 0 .93l2.652 2.625L5.435 7.02c-.246.247-.246.657 0 .93l.629.602a.63.63 0 0 0 .93 0l3.718-3.719c.246-.246.246-.656 0-.93"/></svg></span>
            </p>
        </div>
    </a>
</article>
