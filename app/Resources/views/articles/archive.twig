{% extends 'layouts/default.twig' %}

{% block content %}
<div class="container py-12">
    <div class="sm:w-10/12 sm:mx-auto">
        {% include "components/atoms/heading/h1.twig" with {
            text: term.name|default(post.title)
        } %}

        {% include "components/organisms/search-form.twig" %}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 sm:w-10/12 sm:mx-auto gap-5">
        {% for post in posts %}
            {% include ["articles/teases/tease-" ~ post.post_type ~ ".twig", "articles/teases/tease.twig"] %}
        {% endfor %}
    </div>

    {% include "components/pagination.twig" with {
        pagination: posts.pagination({
            show_all: false,
            mid_size: 2,
            end_size: 2
        })
    } %}
</div>


{% endblock %}
