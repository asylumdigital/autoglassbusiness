{% set logo = theme.theme_mod('custom_logo') %}
<header class="w-full sticky top-0 bg-white py-3 z-50 border-b border-highlight shadow-md">
    <div class="container flex">
        <div class="flex justify-between items-center w-full xl:w-fit">
            <a href="/" title="" class="w-20 lg:w-33 lg:mr-16">
                <img src="{{ 'autoglass.svg'|theme }}" alt="{{ site.name }}" />
            </a>
            {% include 'components/menu-icon.twig' %}
        </div>
        <div class="flex flex-col xl:flex-row grow xl:items-center absolute bg-white xl:bg-transparent xl:static w-full -right-full top-22 h-[calc(100dvh-88px)] xl:w-auto xl:right-auto xl:top-auto xl:h-auto transition-all p-4 xl:p-0" :class="{'right-0': menu}">
             {% include "modules/global/nav.twig" %}

            <div class="flex flex-col xl:flex-row gap-6 xl:ml-auto mt-auto">
                {% include "components/atoms/button.twig" with {
                    url: '#',
                    text: 'Open an account',
                    size: 'md',
                } %}

                {% include "components/atoms/button.twig" with {
                    url: '#',
                    text: 'Make an enquiry',
                    secondary: true,
                    size: 'md',
                } %}
            </div>
        </div>
    </div>
</header>
