<footer class="global-footer">
  <div class="container">
    <div class="row">
      {% for i in 1..4 %}
      <div class="col-md-6 col-xl-3">
      {% set menu = 'footer_' ~ i %}
      <h3 class="footer-menu-label">{{ fn('get_field', 'menu_title', menus[menu]) }}</h3>

      {% include 'components/nav.twig' with {
        nav: menus[menu].get_items,
        multilevel: false,
        class: 'footer-nav'
      } only %}

      </div>
      {% endfor %}
    </div>
  </div>
</footer>
<section class="boilerplate">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <a href="/" class="footer-logo">
          [logo]
        </a>
      </div>
    </div>
  </div>
</section>
