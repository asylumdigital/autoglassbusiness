<section class="suggested-articles">
  <div class="container">
    {% if suggestedTitle %}
    <div class="row">
      <div class="col-12">
        <h2 class="title">{{ suggestedTitle }}</h2>
      </div>
    </div>
    {% endif %}
    <div class="row">
      {% for post in articles %}
      <div class="col-md-4">
        {% include "articles/teases/card.twig" %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
