<section class="py-12">
    <div class="container">
        <div class="grid grid-cols-2 gap-9">
            {% for item in 1..2 %}
                <div>
                    <div class="bg-default text-white flex">

                        <div class="aspect-31/24">
                            <img src="https://picsum.photos/341/264" class="clipped w-full">
                        </div>


                        <div class="p-5 flex-1">
                            <h3 class="font-semibold">ADAS Recalibration</h3>
                            <p>Patented process with exclusive primer and HPX3 resin</p>
                        </div>

                    </div>
                    <div class="flex items-center -translate-y-1/2">
                        <div aria-hidden="true" class="h-1 bg-brand flex-1"></div>
                        {% include "components/atoms/button.twig" with {
                            url: '#',
                            text: 'Find out more',
                            arrow: true,

                        } %}

                    </div>
                </div>
            {% endfor %}
            {% for item in 1..2 %}
                <div>
                    <div class="bg-white flex">
                        <div class="aspect-31/24">
                            <img src="https://picsum.photos/341/264" class="clipped w-full">
                        </div>


                        <div class="p-5 flex-1">
                            <h3 class="font-semibold">ADAS Recalibration</h3>
                            <p>We manage the entire recalibration process from start to finish...</p>
                        </div>

                    </div>
                    <div class="flex items-center -translate-y-1/2">
                        <div aria-hidden="true" class="h-1 bg-brand flex-1"></div>
                        {% include "components/atoms/button.twig" with {
                            url: '#',
                            text: 'Find out more',
                            arrow: true,

                        } %}

                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
