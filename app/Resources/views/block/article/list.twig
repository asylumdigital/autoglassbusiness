{% extends "modules/block/wrapper.twig" %}

{% set type = style|default(block.style)|default('vertical') %}

{% block content %}
    {% include "components/organisms/section-header.twig" with {
        accent: block.eyebrow,
        title: block.title,
        intro: block.introduction

    } %}
    <div class="grid gap-5 {{ type == 'vertical' ? 'sm:grid-cols-2 lg:grid-cols-3' : 'lg:grid-cols-2' }}">
        {% for post in block.posts|default(posts) %}
            {% include "components/organisms/card-" ~ type ~ ".twig" with {
                bg: block.card_color|default('white')
            } %}
        {% endfor %}
    </div>
{% endblock %}
