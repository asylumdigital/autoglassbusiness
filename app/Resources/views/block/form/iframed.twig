{% extends "modules/block/wrapper.twig" %}

{% set iframeHeight = {
    'business-account-opening-webform': 2870,
    'business-account-enquiry-webform': 1500,
} %}

{% block content %}
    <div class="form-container max-w-232.5 mx-auto" id="{{ block.form }}">
        <iframe src="https://cloud.email.autoglass.co.uk/{{ block.form }}" width="100%" height="{{ block.height|default(iframeHeight[block.form]) }}" type="text/html" frameborder="0" allowTransparency="true" style="border: 0" sandbox="allow-scripts allow-forms allow-same-origin allow-top-navigation"></iframe>
    </div>
{% endblock %}
