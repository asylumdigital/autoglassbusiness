{% extends "modules/block/wrapper.twig" %}

{% block content %}
    <div class="{{ block.layout != 'centre' ? 'flex' }} md:w-11/12 md:mx-auto">
        <div{{ block.layout != 'centre' ? ' class="w-5/12"' }}>
            {% include "components/organisms/section-header.twig" with {
                accent: block.eyebrow,
                title: block.title,
                intro: block.introduction,
                outer: block.layout != 'centre' ? 'text-left',
            } %}
        </div>
        <div class="flex-1">
            {% include "components/organisms/video.twig" with {
                provider: block.provider,
                poster: block.poster,
                video: block.provider == 'youtube' ?
                    block.youtube_id
                    : (block.provider == 'vimeo' ? block.vimeo_id : block.video_file)
            } only %}
        </div>
    </div>
{% endblock %}

