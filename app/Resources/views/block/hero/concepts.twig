{# ============================================================
   HERO CONCEPTS — CLIENT REVIEW
   6 stacked concepts, self-contained styling (no Tailwind build
   dependency) so they render as designed.
   Swap --red for the exact brand red before build.
   Video + image sources are placeholders.
   ============================================================ #}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
.agb {
    --red: #E4002B;
    --ink: #111110;
    --muted: #4D4A47;
    --paper: #F6F4F1;
    --line: rgba(17,17,16,.14);
    --cond: 'Barlow Condensed', 'Oswald', 'Arial Narrow', sans-serif;
    --body: 'Inter', system-ui, -apple-system, sans-serif;
    font-family: var(--body);
    color: var(--ink);
    position: relative;
    isolation: isolate;
}
.agb * { box-sizing: border-box; }
.agb h1, .agb h2 { margin: 0; }
.agb p { margin: 0; }
.agb ul { margin: 0; padding: 0; list-style: none; }

/* ---- review chrome (delete before build) ---- */
.agb-tag {
    position: absolute; z-index: 30; top: 0; left: 0;
    display: flex; align-items: baseline; gap: .65rem;
    background: var(--ink); color: #fff;
    padding: .55rem 1.1rem .6rem;
    font-family: var(--cond); text-transform: uppercase;
    letter-spacing: .08em; font-size: .82rem; font-weight: 700;
}
.agb-tag b { color: var(--red); font-size: 1rem; }
.agb-tag i { font-style: normal; opacity: .55; letter-spacing: .12em; font-size: .68rem; }

/* ---- shared atoms ---- */
.agb-eyebrow {
    display: flex; align-items: center; gap: .85rem;
    font-family: var(--cond); font-weight: 700; text-transform: uppercase;
    letter-spacing: .16em; font-size: clamp(.72rem,.9vw,.86rem);
}
.agb-eyebrow::before {
    content: ""; width: clamp(28px,4vw,56px); height: 2px;
    background: var(--red); flex: none;
}
.agb-h1 {
    font-family: var(--cond); font-weight: 900; text-transform: uppercase;
    line-height: .86; letter-spacing: -.005em; text-wrap: balance;
}
.agb-lede { font-size: clamp(1rem,1.15vw,1.3rem); line-height: 1.55; color: var(--muted); max-width: 46ch; }
.agb-btns { display: flex; flex-wrap: wrap; gap: .9rem; }
.agb-btn {
    display: inline-flex; align-items: center; gap: .8rem;
    font-family: var(--cond); font-weight: 700; text-transform: uppercase;
    letter-spacing: .09em; font-size: 1rem;
    padding: 1.05rem 1.6rem; border: 2px solid var(--red);
    background: var(--red); color: #fff; text-decoration: none;
    transition: background .25s, color .25s, border-color .25s, transform .25s;
}
.agb-btn svg { transition: transform .25s; }
.agb-btn:hover { transform: translateY(-2px); }
.agb-btn:hover svg { transform: translateX(4px); }
.agb-btn--ghost { background: transparent; color: var(--ink); border-color: currentColor; }
.agb-btn--ghost:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
.agb-btn--light { background: transparent; color: #fff; border-color: rgba(255,255,255,.5); }
.agb-btn--light:hover { background: #fff; color: var(--ink); border-color: #fff; }

@media (prefers-reduced-motion: reduce) {
    .agb *, .agb *::before, .agb *::after { animation: none !important; transition: none !important; }
}

/* ============================================================
   01 — KINETIC SPLIT   (video)
   ============================================================ */
.hv1 { background: var(--paper); overflow: hidden; }
.hv1-grid {
    display: grid; grid-template-columns: 1fr; align-items: stretch;
    min-height: min(92vh, 900px);
}
.hv1-content {
    padding: clamp(4.5rem,7vw,7rem) clamp(1.5rem,5vw,5.5rem) clamp(2.5rem,4vw,4rem);
    display: flex; flex-direction: column; justify-content: center; gap: clamp(1.4rem,2vw,2.2rem);
    position: relative; z-index: 2;
}
.hv1 .agb-h1 { font-size: clamp(3.4rem,7.4vw,7.6rem); display: flex; flex-direction: column; }
.hv1 .agb-h1 span { display: block; animation: hv1Rise .9s cubic-bezier(.2,.8,.2,1) backwards; }
.hv1 .agb-h1 span:nth-child(2) { animation-delay: .1s; padding-left: .09em; }
.hv1 .agb-h1 span:nth-child(3) { animation-delay: .2s; color: var(--red); padding-left: .18em; }
@keyframes hv1Rise { from { opacity: 0; transform: translateY(.5em); } }
.hv1-stats {
    display: flex; flex-wrap: wrap; gap: clamp(1.5rem,3vw,3rem);
    border-top: 1px solid var(--line); padding-top: 1.4rem; margin-top: .6rem;
}
.hv1-stats b {
    display: block; font-family: var(--cond); font-weight: 900;
    font-size: clamp(1.9rem,2.6vw,2.6rem); line-height: 1;
}
.hv1-stats span { font-size: .78rem; text-transform: uppercase; letter-spacing: .11em; color: var(--muted); }
.hv1-media { position: relative; min-height: 46vh; }
.hv1-media video, .hv1-media img.hv1-fallback {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
}
.hv1-media::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(200deg, rgba(17,17,16,0) 45%, rgba(17,17,16,.55));
}
.hv1-card {
    position: absolute; z-index: 3; left: clamp(1rem,2vw,2rem); bottom: clamp(1rem,2vw,2rem);
    background: rgba(255,255,255,.94); backdrop-filter: blur(6px);
    padding: 1.1rem 1.4rem; max-width: 15rem; border-left: 3px solid var(--red);
}
.hv1-card b { display: block; font-family: var(--cond); font-weight: 900; font-size: 2.2rem; line-height: 1; }
.hv1-card span { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
@media (min-width: 1024px) {
    .hv1-grid { grid-template-columns: 1.02fr 1fr; }
    .hv1-media { clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%); margin-left: -6%; }
    .hv1-content { padding-right: 3rem; }
}

/* ============================================================
   02 — CINEMATIC FULL-BLEED   (video)
   ============================================================ */
.hv2 { position: relative; min-height: min(94vh,940px); display: flex; align-items: flex-end; overflow: hidden; background: var(--ink); }
.hv2-bg, .hv2-bg video, .hv2-bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.hv2-bg::after {
    content: ""; position: absolute; inset: 0;
    background:
        linear-gradient(90deg, rgba(10,10,10,.92) 0%, rgba(10,10,10,.62) 42%, rgba(10,10,10,.15) 78%),
        linear-gradient(0deg, rgba(10,10,10,.85), rgba(10,10,10,0) 55%);
}
.hv2-inner {
    position: relative; z-index: 2; color: #fff; width: 100%;
    padding: clamp(6rem,10vw,9rem) clamp(1.5rem,5vw,5.5rem) 0;
    display: flex; flex-direction: column; gap: clamp(1.3rem,2vw,2rem);
}
.hv2 .agb-eyebrow { color: #fff; }
.hv2 .agb-h1 { font-size: clamp(3.6rem,10vw,10.5rem); max-width: 14ch; }
.hv2 .agb-h1 em { font-style: normal; color: var(--red); }
.hv2 .agb-lede { color: rgba(255,255,255,.78); }
.hv2-bar {
    position: relative; z-index: 2; width: 100%;
    margin-top: clamp(2.5rem,5vw,4.5rem);
    border-top: 1px solid rgba(255,255,255,.18);
    background: rgba(255,255,255,.05); backdrop-filter: blur(10px);
    display: grid; grid-template-columns: repeat(2,1fr);
}
.hv2-bar li {
    padding: 1.3rem clamp(1.5rem,4vw,3rem);
    border-right: 1px solid rgba(255,255,255,.14);
    border-bottom: 1px solid rgba(255,255,255,.14);
    color: #fff;
}
.hv2-bar li:last-child { border-right: 0; }
.hv2-bar b { display: block; font-family: var(--cond); font-weight: 900; font-size: clamp(1.8rem,2.4vw,2.5rem); line-height: 1; }
.hv2-bar span { font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; opacity: .62; }
@media (min-width: 900px) {
    .hv2-bar { grid-template-columns: repeat(4,1fr); }
    .hv2-bar li { border-bottom: 0; }
    .hv2-inner { padding-bottom: 0; }
}

/* ============================================================
   03 — EDITORIAL MOSAIC   (images)
   ============================================================ */
.hv3 { background: #fff; padding: clamp(4.5rem,7vw,7rem) clamp(1.5rem,5vw,5rem) clamp(3rem,5vw,5rem); }
.hv3-grid { display: grid; grid-template-columns: repeat(12,1fr); gap: clamp(.9rem,1.4vw,1.5rem); align-items: end; }
.hv3-head { grid-column: 1 / -1; }
.hv3 .agb-h1 { font-size: clamp(3.2rem,9.2vw,9rem); margin-top: 1.2rem; }
.hv3 .agb-h1 u { text-decoration: none; -webkit-text-stroke: 2px var(--ink); color: transparent; }
.hv3 .agb-h1 em { font-style: normal; color: var(--red); }
.hv3-tile { position: relative; overflow: hidden; background: var(--paper); }
.hv3-tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .7s cubic-bezier(.2,.8,.2,1); }
.hv3-tile:hover img { transform: scale(1.05); }
.hv3-tile figcaption {
    position: absolute; left: 0; bottom: 0; z-index: 2;
    background: var(--ink); color: #fff;
    font-family: var(--cond); font-weight: 700; text-transform: uppercase; letter-spacing: .12em;
    font-size: .72rem; padding: .5rem .85rem;
}
.hv3-a { grid-column: 1 / -1; aspect-ratio: 16/10; }
.hv3-b { grid-column: 1 / span 6; aspect-ratio: 4/5; }
.hv3-c { grid-column: 7 / span 6; aspect-ratio: 4/5; }
.hv3-copy { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 1.5rem; padding-top: .5rem; }
.hv3-note {
    grid-column: 1 / -1; background: var(--red); color: #fff;
    padding: clamp(1.4rem,2.5vw,2.2rem); display: flex; flex-direction: column; justify-content: flex-end; min-height: 10rem;
}
.hv3-note b { font-family: var(--cond); font-weight: 900; font-size: clamp(2.4rem,3.6vw,3.6rem); line-height: .95; display: block; }
.hv3-note span { font-size: .78rem; text-transform: uppercase; letter-spacing: .12em; opacity: .85; margin-top: .4rem; display: block; }
@media (min-width: 900px) {
    .hv3-head { grid-column: 1 / span 8; }
    .hv3-a { grid-column: 1 / span 5; aspect-ratio: 3/4; }
    .hv3-b { grid-column: 6 / span 4; aspect-ratio: 1/1; }
    .hv3-c { grid-column: 10 / span 3; aspect-ratio: 3/4; }
    .hv3-copy { grid-column: 6 / span 4; }
    .hv3-note { grid-column: 10 / span 3; }
}

/* ============================================================
   04 — TYPE STACK + MARQUEE   (no imagery)
   ============================================================ */
.hv4 { background: var(--ink); color: #fff; overflow: hidden; padding: clamp(5rem,8vw,8rem) 0 0; }
.hv4-inner { padding: 0 clamp(1.5rem,5vw,5.5rem); display: flex; flex-direction: column; gap: clamp(1.6rem,2.5vw,2.4rem); }
.hv4 .agb-eyebrow { color: #fff; }
.hv4 .agb-h1 { font-size: clamp(3.4rem,12.5vw,13rem); line-height: .82; }
.hv4 .agb-h1 span { display: block; }
.hv4 .agb-h1 u {
    text-decoration: none; color: transparent;
    -webkit-text-stroke: clamp(1px,.16vw,2px) rgba(255,255,255,.72);
}
.hv4 .agb-h1 em { font-style: normal; color: var(--red); }
.hv4-row { display: flex; flex-wrap: wrap; gap: clamp(1.5rem,4vw,4rem); align-items: flex-end; justify-content: space-between; }
.hv4 .agb-lede { color: rgba(255,255,255,.7); }
.hv4-marquee {
    margin-top: clamp(2.5rem,5vw,4.5rem);
    background: var(--red); color: #fff;
    display: flex; overflow: hidden; white-space: nowrap;
    border-top: 1px solid rgba(255,255,255,.2);
}
.hv4-track {
    display: flex; flex: none; align-items: center; gap: 2.5rem;
    padding: .95rem 1.25rem;
    font-family: var(--cond); font-weight: 800; text-transform: uppercase;
    letter-spacing: .14em; font-size: clamp(.9rem,1.3vw,1.15rem);
    animation: hv4Slide 26s linear infinite;
}
.hv4-track span { display: inline-flex; align-items: center; gap: 2.5rem; }
.hv4-track span::after { content: ""; width: 6px; height: 6px; background: rgba(255,255,255,.6); border-radius: 50%; }
@keyframes hv4Slide { to { transform: translateX(-100%); } }

/* ============================================================
   05 — THROUGH THE WINDSCREEN   (image + glass motif)
   ============================================================ */
.hv5 { position: relative; min-height: min(94vh,940px); background: var(--ink); overflow: hidden; display: flex; align-items: center; }
.hv5-bg { position: absolute; inset: 0; }
.hv5-bg img { width: 100%; height: 100%; object-fit: cover; }
.hv5-bg::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(105deg, rgba(8,10,14,.9) 0%, rgba(8,10,14,.55) 55%, rgba(8,10,14,.25) 100%);
}
.hv5-glass {
    position: absolute; inset: clamp(.75rem,2vw,1.75rem);
    border: 1px solid rgba(255,255,255,.22);
    border-radius: clamp(18px,3vw,44px);
    background: linear-gradient(160deg, rgba(255,255,255,.11), rgba(255,255,255,0) 42%);
    pointer-events: none; overflow: hidden;
}
.hv5-wipe {
    position: absolute; left: -30%; top: -60%; width: 55%; height: 220%;
    background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.16), rgba(255,255,255,0));
    transform: skewX(-14deg);
    animation: hv5Wipe 7s cubic-bezier(.5,0,.3,1) infinite;
}
@keyframes hv5Wipe {
    0%, 62% { transform: translateX(0) skewX(-14deg); }
    100% { transform: translateX(320%) skewX(-14deg); }
}
.hv5-crack { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.hv5-crack path {
    fill: none; stroke: rgba(255,255,255,.75); stroke-width: 1.4;
    stroke-dasharray: 620; stroke-dashoffset: 620;
    animation: hv5Heal 7s ease-in-out infinite;
}
@keyframes hv5Heal {
    0% { stroke-dashoffset: 620; opacity: 0; }
    18% { stroke-dashoffset: 0; opacity: .9; }
    58% { stroke-dashoffset: 0; opacity: .9; }
    76%, 100% { stroke-dashoffset: -620; opacity: 0; }
}
.hv5-inner {
    position: relative; z-index: 3; color: #fff;
    padding: clamp(5rem,8vw,7rem) clamp(2.5rem,7vw,7rem);
    display: flex; flex-direction: column; gap: clamp(1.3rem,2vw,2rem); max-width: 60rem;
}
.hv5 .agb-eyebrow { color: #fff; }
.hv5 .agb-h1 { font-size: clamp(3.4rem,8.4vw,8.5rem); }
.hv5 .agb-h1 em { font-style: normal; color: var(--red); display: block; }
.hv5 .agb-lede { color: rgba(255,255,255,.76); }
.hv5-foot {
    position: relative; z-index: 3; margin-top: clamp(1.5rem,3vw,2.5rem);
    display: flex; flex-wrap: wrap; gap: 1.4rem 2.4rem; align-items: center;
    padding-top: 1.4rem; border-top: 1px solid rgba(255,255,255,.2);
}
.hv5-foot li { display: flex; align-items: center; gap: .6rem; color: rgba(255,255,255,.82); font-size: .8rem; text-transform: uppercase; letter-spacing: .12em; }
.hv5-foot li::before { content: ""; width: 7px; height: 7px; background: var(--red); flex: none; }
</style>


