<section class="relative">
    <div class="container flex lg:block items-center lg:h-full-header">
        <div class="lg:w-1/2 2xl:w-[43%] lg:py-12 py-8">

            {% include "components/atoms/accent-title.twig" with {
                text: 'Nearly 50 years of great partnerships'
            } %}

            <div class="flex items-center py-4">
                <div class="w-1/3 lg:w-auto">
                    <h1 class="font-condensed font-black text-3xl md:text-6xl xl:text-8xl text-balance w-min leading-[.9] lg:mb-8 uppercase">
                        {% for word in "Keeping your business moving"|split(' ') %}
                            <span class="transition-all inline-block {{ loop.last ? 'text-primary' }}" style="--i:{{ loop.index0 }}">{{ word }}</span>
                        {% endfor %}
                    </h1>
                </div>
                <div class="sm:w-2/3 lg:hidden">
                    <div class="aspect-video image " style="--clip-hero: polygon(20% 0%, 100% 0, 100% 100%, 0% 100%);">
                        <img src="https://picsum.photos/662/975" class="object-cover w-full h-full" />
                    </div>
                </div>
            </div>

            <p class="text-sm sm:text-base md:text-lg xl:text-2xl text-[#4D4A47]">Great business relationships are all about teamwork. For nearly 50 years we’ve been working with Fleet and Insurance clients to deliver the market leading key-to-key service they need.</p>

            <div class="flex flex-col gap-4 sm:flex-row lg:gap-11 lg:ml-auto mt-6 xl:mt-20">
                {% include "components/atoms/button.twig" with {
                    url: '#',
                    text: 'Open an account',
                    arrow: true,
                } %}

                {% include "components/atoms/button.twig" with {
                    url: '#',
                    text: 'Make an enquiry',
                    secondary: true,
                    arrow: true,
                } %}
            </div>
        </div>
        <div class="image ml-auto absolute right-0 w-1/2 top-0 h-full hidden lg:block">
            <img src="https://picsum.photos/662/975" class="object-cover w-full h-full" />
        </div>
    </div>
</section>
