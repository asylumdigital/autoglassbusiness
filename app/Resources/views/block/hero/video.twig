<section class="relative hero-bg bg-cover bg-top-right bg-no-repeat hero-bg--{{ block.block_position }}">
    <div class="container flex lg:block items-end lg:items-center h-full-header lg:h-auto">
        <div class="lg:w-1/2 2xl:w-[43%] lg:py-12 py-8 relative z-10">

            {% if block.eyebrow %}
                {% include "components/atoms/accent-title.twig" with {
                    text: block.eyebrow
                } %}
            {% endif %}


            <div class="flex items-center py-4">
                <div class="w-1/3 lg:w-auto">
                    <h1 class="font-condensed text-black font-black text-5xl md:text-6xl xl:text-8xl text-balance w-min leading-[.9] lg:mb-8 uppercase">
                        {% for word in block.title|split(' ') %}
                            <span class="transition-all inline-block {{ loop.last ? 'text-primary' }}" style="--i:{{ loop.index0 }}">{{ word }}</span>
                        {% endfor %}
                    </h1>
                </div>
            </div>

            <p class="text-sm sm:text-base md:text-lg xl:text-2xl text-[#4D4A47]">{{ block.content|esc_html }}</p>

            {% if block.buttons %}
                <div class="flex flex-col gap-4 sm:flex-row lg:gap-11 lg:ml-auto mt-6 xl:mt-20">
                    {% for button in block.buttons %}
                        {% include "components/atoms/button.twig" with {
                            url: button.link.url,
                            text: button.link.title,
                            secondary: button.style == 'secondary',
                            tertiary: button.style == 'tertiary',
                            arrow: true,
                        } %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
    <div class="lg:hidden absolute w-full h-[88%] bg-linear-to-t from-white via-25% via-white/90 to-transparent bottom-0"></div>
    {% if block.left_gradient %}
        <div class="hidden lg:block absolute w-full h-full bg-linear-to-r from-white/95 via-25% to-60% via-white/90 to-transparent bottom-0"></div>
    {% endif %}

</section>
