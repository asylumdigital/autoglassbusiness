{% extends "modules/block/wrapper.twig" %}

{# {% do addCss('demo') %} #}
{# {% do addJs('demo') %} #}

{% set classes = {
    image: '',
    content: 'lg:col-start-6 xl:col-start-7 2xl:col-start-6',
} %}

{% if block.align == 'right' %}
    {% set classes = {
        image: 'md:flex md:justify-end lg:col-start-9 xl:col-start-8',
        content: 'lg:col-start-2 lg:row-start-1 xl:col-start-2 2xl:col-start-2',
    } %}
{% endif %}


{% block content %}

    <div class="grid lg:grid-cols-12 md:w-11/12 md:mx-auto">
        <div class="space-y-10 xl:space-y-20 col-span-5 xl:col-start-2 xl:col-span-5 lg:col-span-7">

            {% if block.eyebrow %}
                {% include "components/atoms/accent-title.twig" with {
                    text: block.eyebrow,
                } %}
            {% endif %}

            <h1 class="text-4xl md:text-6xl font-condensed font-black xl:text-7xl uppercase flex flex-col">
                {% for word in block.title|split("\r\n") %}
                    <span>{{ word|esc_html }}</span>
                {% endfor %}
            </h1>

            <p class="text-lg xl:text-2xl max-w-2xl">{{ block.content|wp_kses_post }}</p>

            {% if block.buttons.primary.url or block.buttons.secondary.url %}
                <div class="md:flex-row flex-col flex gap-4 md:gap-8 lg:gap-4">
                    {% if block.buttons.primary.url %}
                        {% include "components/atoms/button.twig" with {
                            url: block.buttons.primary.url,
                            text: block.buttons.primary.title,
                            arrow: true,
                        } %}
                    {% endif %}
                    {% if block.buttons.secondary.url %}
                        {% include "components/atoms/button.twig" with {
                            url: block.buttons.secondary.url,
                            text: block.buttons.secondary.title,
                            secondary: true,
                            arrow: true,
                        } %}
                    {% endif %}
                </div>
            {% endif %}
        </div>
        <div class="col-span-5 lg:col-span-4 xl:col-span-5 lg:col-start-9 xl:col-start-8 lg:flex items-end hidden">
            {% include "components/molecules/image.twig" with {
                image: block.image,
                wrapper: 'max-w-112.5'
            } %}
            {# <img src="https://picsum.photos/850" class="clipped sticky w-full top-0 max-w-112.5" /> #}
        </div>
    </div>


{% endblock %}

