{% if block.links %}
    <div x-data="jump_links">
        <div class="mb-3 pt-4 font-mono tracking-widest uppercase text-xxs">{{ block.title }}</div>
        <nav class="space-y-1">
            <h3>In this article</h3>
            {% for link in block.links %}
                <a href="#{{ link.id }}" class="block py-1 text-xs transition" :class="isActive('{{ link.id }}')
                        ? 'text-black font-semibold'
                        : 'text-black/80'">
                    {{ link.title }}
                </a>
            {% endfor %}
        </nav>
    </div>
{% endif %}
