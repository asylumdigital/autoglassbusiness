{% if block.links %}
    <div x-data="jump_links">
        <nav class="space-y-1">
            {% if block.title %}
                <h3 class="mb-3 pt-4 font-condensed font-bold text-xxs">{{ block.title }}</h3>
            {% endif %}

            {% for link in block.links %}
                <a href="#{{ link.id }}" class="block py-1 text-xs transition" :class="isActive('{{ link.id }}')
                        ? 'text-black font-semibold'
                        : 'text-black/80'">
                    {{ link.title }}
                </a>
            {% endfor %}
        </nav>
    </div>
{% endif %}
