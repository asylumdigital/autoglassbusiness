{% if block.links %}
    <div class="mb-3 pt-4 font-mono tracking-widest uppercase text-xxs text-stone-400 dark:text-stone-600">{{ block.title }}</div>
    <nav class="space-y-1">
        <h3>In this article</h3>
        {% for link in block.links %}
            <a href="#{{ link.id }}" class="block py-1 text-xs transition text-stone-400 dark:text-stone-500 hover:text-stone-600 dark:hover:text-stone-300" :class="isActive('{{ link.id }}')
                    ? 'text-brand font-semibold'
                    : 'text-stone-400 dark:text-stone-500 hover:text-stone-600 dark:hover:text-stone-300'">
                {{ link.title }}
            </a>
        {% endfor %}
    </nav>
{% endif %}
