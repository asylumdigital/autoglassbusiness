{% extends "modules/block/wrapper.twig" %}

{% set container = 'max-w-none' %}

{% set sectionAttributes = {
    'x-data': "carousel",
} %}

{% set blockStyle = block.style %}

{% set block = block|merge({'style': 'value'}) %}

{% do addCss('carousel') %}
{% do addJs('demo') %}

{% block content %}
    {% include "components/organisms/section-header.twig" with {
        accent: block.eyebrow,
        title: block.title,
        intro: block.introduction,

    } %}
    <div class="{{ block.background == 'dark' ? 'bg-default text-white' : 'bg-highlight' }} mt-12">
        <div class="swiper swiper--flow" x-ref="carousel">
            <div class="swiper-wrapper">
                {# Slides #}
                <InnerBlocks allowedBlocks="{{ ['acf/quote-slide']|json_encode|e('html_attr') }}" />
            </div>
        </div>
    </div>
{% endblock %}
