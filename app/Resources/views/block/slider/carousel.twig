{% extends "modules/block/wrapper.twig" %}

{% set container = 'max-w-none relative' %}

{% set sectionAttributes = {
    'x-data': "carousel",
} %}

{% set blockStyle = block.style %}

{% set block = block|merge({'style': 'value'}) %}

{% do addCss('carousel') %}
{% do addJs('demo') %}

{% block content %}
    {% include "components/organisms/section-header.twig" with {
        accent: block.eyebrow,
        title: block.title,
        intro: block.introduction,

    } %}
    <div class="{{ block.background == 'dark' ? 'bg-default text-white' : 'bg-highlight' }} mt-12">
        <div class="swiper swiper--flow" x-ref="carousel">
            <div class="swiper-wrapper">
                {# Slides #}
                <InnerBlocks allowedBlocks="{{ ['acf/quote-slide']|json_encode|e('html_attr') }}" />
            </div>
        </div>

        {% if block.pagination or block.navigation %}
            <div class="flex items-center gap-4 absolute bottom-0 right-0 z-10 {{ not block.navigation ? 'px-4 py-1' }}">
                {% if block.pagination %}
                    <div>
                        <div class="swiper-pagination" x-ref="pagination"></div>
                    </div>
                {% endif %}

                {% if block.navigation %}
                    <div class="flex">
                        <button type="button" aria-label="Previous" class="swiper-button--prev aspect-square w-8 bg-secondary cursor-pointer flex items-center justify-center" x-ref="prev">
                            <span class="w-4 block">
                                {% include "components/atoms/icons/svg/chevron-left.svg" %}
                            </span>
                            <span class="sr-only">Prev</span>
                        </button>
                        <button type="button" aria-label="Next" class="swiper-button--next aspect-square w-8 bg-secondary cursor-pointer flex items-center justify-center" x-ref="next">
                            <span class="w-4 block">
                                {% include "components/atoms/icons/svg/chevron.svg" %}
                            </span>
                            <span class="sr-only">Next</span>
                        </button>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
