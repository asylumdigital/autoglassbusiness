{% extends "modules/block/wrapper.twig" %}

{% do addCss('marquee') %}

{% set container = 'container max-w-none px-0' %}

{% set padding = 'p-0' %}

{% if block.background in ['bg-default', 'bg-primary', 'bg-tertiary'] %}
    {% set color = 'text-white' %}
{% endif %}

{% set loops = 2 %}

{% if isBlockEditor or fn('is_admin') %}
    {% set loops = 1 %}
{% endif %}

{% block content %}
    {% if block.eyebrow %}
        {% include "components/organisms/section-header.twig" with {
            accent: 'Working with great partners',
        } %}
    {% endif %}
    <div class="marquee {{ block.reverse ? 'marquee--reverse' }} {{ block.background|default('bg-highlight') }} py-8 {{ color }}">
        {% for r in 1..loops %}
            <ul class="marquee__content{{ isBlockEditor or fn('is_admin') ? ' flex list-none items-center' }}"{{ not loop.first ? ' aria-hidden="true"' }}>
                {% for item in block.items.partners %}
                    <li>
                        {% if item.link %}<a href="{{ item.link }}">{% endif %}
                        {% if item.partner_logo %}
                            <img src="{{ item.partner_logo.url }}" class="max-h-10 min-h-9 w-auto" width="{{ item.partner_logo.width }}" height="{{ item.partner_logo.height }}" alt="{{ item.partner_logo.alt|default(item.partner_name)|esc_attr }}" loading="lazy" />
                        {% else %}
                            <span class="font-semibold">{{ item.partner_name|esc_html }}</span>
                        {% endif %}

                        {% if item.link %}</a>{% endif %}
                    </li>
                {% endfor %}
                {# <li>
                    <img src="{{ 'placeholder/logos/DLine 4.png'|theme }}" class="max-h-10" />
                </li> #}
            </ul>
        {% endfor %}

    </div>
{% endblock %}
