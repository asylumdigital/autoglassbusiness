{% extends "modules/block/wrapper.twig" %}

{% do addCss('marquee') %}
{% set container = 'container max-w-none px-0' %}

{% set padding = 'p-0' %}

{% if block.background in ['bg-default', 'bg-primary', 'bg-tertiary'] %}
    {% set color = 'text-white' %}
{% endif %}


{% block content %}
    {% include "components/organisms/section-header.twig" with {
        accent: 'Working with great partners',
        outer: 'container text-left mb-8 mt-8',
    } %}
    <div class="marquee {{ block.reverse ? 'marquee--reverse' }} {{ block.background|default('bg-highlight') }} py-8 {{ color }}">
        <ul class="marquee__content">
            <li>Item 1</li>
            <li><a href="#">Item 2</a></li>
            <li>Item 3</li>
            <li>Item 4</li>
            <li>Item 5</li>
            <li>Item 6</li>
            <li>Item 7</li>
            <li>Item 8</li>
            <li>Item 9</li>
            <li>Item 10</li>
            <li>Item 11</li>
            <li>Item 12</li>
            <li>
                <img src="{{ 'placeholder/logos/DLine 4.png'|theme }}" class="max-h-10" />
            </li>
        </ul>
        <!-- Mirrors the content above -->
        <ul class="marquee__content" aria-hidden="true">
            <li>Item 1</li>
            <li><a href="#">Item 2</a></li>
            <li>Item 3</li>
            <li>Item 4</li>
            <li>Item 5</li>
            <li>Item 6</li>
            <li>Item 7</li>
            <li>Item 8</li>
            <li>Item 9</li>
            <li>Item 10</li>
            <li>Item 11</li>
            <li>Item 12</li>
            <li>
                <img src="{{ 'placeholder/logos/DLine 4.png'|theme }}" class="max-h-10" />
            </li>

        </ul>
    </div>
{% endblock %}
