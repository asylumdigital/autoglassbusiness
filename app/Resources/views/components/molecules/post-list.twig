{% if posts %}
    <ul class="pl-4">
        {% for item in posts %}
            <li>
                <a href="{{ item.link }}" class="hover:underline">{{ item.title }}</a>

                {% if item.children({'post_type': item.post_type}) %}
                    {% include "components/molecules/post-list.twig" with { posts: item.children({'post_type': item.post_type}) } %}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}

