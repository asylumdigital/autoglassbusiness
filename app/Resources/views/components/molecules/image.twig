{% if image %}
    {% set attributes = {
        class: class|default('w-full h-full object-cover'),
        loading: 'lazy',
    } %}

    {% set attributes = attributes|merge(atts|default({})) %}

    <figure{{ parent ? ' class="%s"'|format(parent) }}>
        {% set ratio = aspect == 'video' ? 'aspect-video clip-video' : (':' in aspect ? aspect : 'aspect-square clip-square') %}
        <div class="{{ ratio }} relative group image-hover {{ wrapper }}">
            {{ picture(image|default(fallback_image), size, attributes) }}

            {% if 'clip-' in ratio %}
                <div class="image-hover__container">
                    <div class="image-hover__bar image-hover__bar--secondary"></div>
                    <div class="image-hover__bar image-hover__bar--primary"></div>
                </div>
            {% endif %}
        </div>

        {% if caption %}
            <figcaption>{{ caption|esc_html }}</figcaption>
        {% endif %}
    </figure>
{% endif %}
