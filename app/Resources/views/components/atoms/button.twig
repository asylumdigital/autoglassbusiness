
{% set classList = (secondary ? 'bg-secondary hover:bg-secondary-hover' : (tertiary ? 'bg-tertiary hover:bg-tertiary-hover text-white' : 'bg-primary hover:bg-primary-hover text-white')) ~ ' gap-5 flex items-center shadow-md hover:shadow-lg cursor-pointer font-condensed font-bold text-lg xl:text-xl py-4 px-6 leading-none tracking-wide justify-between transition-all' %}

{% set classList = classList ~ ' ' ~ width|default('w-full sm:w-fit') %}

{% if url %}
    <a href="{{ url }}" class="{{ classList }}">
        {{ text|default('Click') }}

        {% if arrow %}
            {% if arrow_type != 'arrow' %}
                <span class="w-2.5">
                    {% include "components/atoms/icons/svg/chevron.svg" %}
                </span>
            {% else %}
                <span class="size-4">
                    {% include "components/atoms/icons/svg/arrow.svg" %}
                </span>
            {% endif %}
        {% endif %}
    </a>
{% else %}
    <button type="{{ type|default('button') }}" class="{{ classList }}">
        {{ text|default('Click') }}

        {% if arrow %}
            {% if arrow_type != 'arrow' %}
                <span class="w-2.5">
                    {% include "components/atoms/icons/svg/chevron.svg" %}
                </span>
            {% else %}
                <span class="size-4">
                    {% include "components/atoms/icons/svg/arrow.svg" %}
                </span>
            {% endif %}
        {% endif %}
    </button>
{% endif %}


