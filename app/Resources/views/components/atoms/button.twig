
{% set classList = (secondary ? 'bg-secondary' : (tertiary ? 'bg-tertiary text-white' : 'bg-primary text-white')) ~ ' gap-5 flex items-center shadow-md transition-shadow hover:shadow-lg cursor-pointer rounded-sm font-condensed font-bold text-xl py-4 px-6 leading-none tracking-wide justify-between w-full sm:w-fit' %}

{% if url %}
    <a href="{{ url }}" class="{{ classList }}">
        {{ text|default('Click') }}

        {% if arrow %}
            {% if arrow_type != 'arrow' %}
                <span class="w-2.5">
                    {% include "components/atoms/icons/svg/chevron.svg" %}
                </span>
            {% else %}
                <span class="size-4">
                    {% include "components/atoms/icons/svg/arrow.svg" %}
                </span>
            {% endif %}
        {% endif %}
    </a>
{% else %}
    <button type="{{ type|default('button') }}" class="{{ classList }}">
        {{ text|default('Click') }}

        {% if arrow %}
            {% if arrow_type != 'arrow' %}
                <span class="w-2.5">
                    {% include "components/atoms/icons/svg/chevron.svg" %}
                </span>
            {% else %}
                <span class="size-4">
                    {% include "components/atoms/icons/svg/arrow.svg" %}
                </span>
            {% endif %}
        {% endif %}
    </button>
{% endif %}


