<div class="w-full aspect-video bg-default relative overflow-clip" x-data="{{ provider }}('{{ provider != 'direct' ? video : '' }}')">
    {# {{ dump() }} #}
    {# poster #}
    <button type="button" class="cursor-pointer w-full h-full block group absolute top-0 left-0" x-ref="button" {{ not fn('is_admin') ? '@click="play" :class="{ hidden: state === \'playing\'}"' }}>
        <img src="{{ poster.url }}" width="{{ poster.width }}" height="{{ poster.height }}" alt="{{ poster.alt }}" loading="lazy" class="w-full h-full object-cover" />
        <div class="z-10 absolute aspect-square w-2/12 top-1/2 left-1/2 -translate-1/2 opacity-15 group-hover:opacity-100 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="white"><path d="M128 80L128 560L560 320L128 80z"/></svg>

            {# <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"  fill="white" class=" animate-spin"><path opacity=".4" d="M64 320C64 461.4 178.6 576 320 576C414.7 576 497.5 524.5 541.7 448L486.3 416C453.1 473.4 391.1 512 320 512C214 512 128 426 128 320C128 214 214 128 320 128L320 64C178.6 64 64 178.6 64 320z"/><path d="M541.7 448C563.5 410.4 576 366.6 576 320C576 178.6 461.4 64 320 64L320 128C426 128 512 214 512 320C512 355 502.6 387.8 486.3 416L541.7 448z"/></svg> #}
        </div>
    </button>

    {% if provider == 'direct' %}
        <video src="{{ video.url }}" controls controlsList="nodownload" disablepictureinpicture x-ref="player" />
    {% else %}
        <div x-ref="player" class="w-full h-full player--{{ provider }}">

        </div>
    {% endif %}


</div>
