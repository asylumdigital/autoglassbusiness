{% if pagination.pages is not empty %}
    <div class="pagination w-fit mx-auto mt-8 text-sm lg:text-lg">
        <ul class="pagination-links flex items-center gap-2 lg:gap-4">
        {% if pagination.pages|first and pagination.pages|first.current != true %}
            <li class="item first hidden lg:block">
                <a href="{{ pagination.pages|first.link }}" class="size-8 lg:size-12 flex items-center justify-center">
                    <span class="sr-only">First</span>
                    <span class="size-4 block">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="20" viewBox="0 0 25 20" class="w-full h-full object-contain"><path fill="currentColor" fill-rule="nonzero" d="M12.469 11.038c-.565-.562-.565-1.499 0-2.123L21 .422c.627-.563 1.568-.563 2.133 0l1.443 1.436c.564.624.564 1.561 0 2.123L18.49 10.04l6.086 5.995c.564.562.564 1.5 0 2.124l-1.443 1.374c-.565.624-1.506.624-2.133 0zM.423 8.915 8.956.422c.627-.563 1.568-.563 2.132 0l1.443 1.436c.565.562.565 1.561 0 2.123L6.446 9.977l6.085 6.057c.565.562.565 1.5 0 2.124l-1.443 1.374a1.45 1.45 0 0 1-2.132 0L.423 11.038c-.564-.562-.564-1.499 0-2.123"/></svg>
                    </span>
                </a>
            </li>
        {% else %}
            <li class="item first cursor-not-allowed opacity-50 hidden lg:block">
                <span class="size-8 lg:size-12 flex items-center justify-center">
                    <span class="sr-only">First</span>
                    <span class="size-3.5 block">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="20" viewBox="0 0 25 20" class="w-full h-full object-contain"><path fill="currentColor" fill-rule="nonzero" d="M12.469 11.038c-.565-.562-.565-1.499 0-2.123L21 .422c.627-.563 1.568-.563 2.133 0l1.443 1.436c.564.624.564 1.561 0 2.123L18.49 10.04l6.086 5.995c.564.562.564 1.5 0 2.124l-1.443 1.374c-.565.624-1.506.624-2.133 0zM.423 8.915 8.956.422c.627-.563 1.568-.563 2.132 0l1.443 1.436c.565.562.565 1.561 0 2.123L6.446 9.977l6.085 6.057c.565.562.565 1.5 0 2.124l-1.443 1.374a1.45 1.45 0 0 1-2.132 0L.423 11.038c-.564-.562-.564-1.499 0-2.123"/></svg>
                    </span>
                </span>
            </li>
        {% endif %}
        {% if pagination.prev %}
            <li class="item prev">
                <a href="{{ pagination.prev.link }}" class="size-8 lg:size-12 flex items-center justify-center">
                    <span class="sr-only">Previous</span>
                    <span class="size-4 block">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="20" viewBox="0 0 13 20" class="w-full h-full object-contain"><path fill="currentColor" fill-rule="nonzero" d="M.469 11.038c-.565-.562-.565-1.499 0-2.123L9 .422c.627-.563 1.568-.563 2.133 0l1.443 1.436c.564.624.564 1.561 0 2.123L6.49 10.04l6.086 5.995c.564.562.564 1.5 0 2.124l-1.443 1.374c-.565.624-1.506.624-2.133 0z"/></svg>
                    </span>
                </a>
            </li>
        {% else %}
            <li class="item prev cursor-not-allowed opacity-50">
                <span class="size-8 lg:size-12 flex items-center justify-center">
                    <span class="sr-only">Previous</span>
                    <span class="size-3.5 block">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="20" viewBox="0 0 13 20" class="w-full h-full object-contain"><path fill="currentColor" fill-rule="nonzero" d="M.469 11.038c-.565-.562-.565-1.499 0-2.123L9 .422c.627-.563 1.568-.563 2.133 0l1.443 1.436c.564.624.564 1.561 0 2.123L6.49 10.04l6.086 5.995c.564.562.564 1.5 0 2.124l-1.443 1.374c-.565.624-1.506.624-2.133 0z"/></svg>
                    </span>
                </span>
            </li>
        {% endif %}
        {% for page in pagination.pages %}
            {% if page.link %}
                <li class="item">
                    <a href="{{ page.link }}" class="{{ page.class }} size-8 lg:size-12 flex items-center justify-center">{{ page.title }}</a>
                </li>
            {% elseif page.class == 'dots' %}
                <li class="separator">
                    <span class="size-8 lg:size-12 flex items-center justify-center">{{ page.title }}</span>
                </li>
            {% else %}
                <li class="item current">
                    <span class="size-8 lg:size-12 flex items-center justify-center bg-primary text-white font-bold">{{ page.title }}</span>
                </li>
            {% endif %}
        {% endfor %}

        {% if pagination.next %}
            <li class="item next">
                <a href="{{ pagination.next.link }}">
                    <span class="size-8 lg:size-12 flex items-center justify-center">
                        <span class="sr-only">Next</span>
                        <span class="size-3.5 block">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="20" viewBox="0 0 13 20" class="w-full h-full object-contain"><path fill="currentColor" fill-rule="nonzero" d="M12.531 11.038c.565-.562.565-1.499 0-2.123L4 .422c-.627-.563-1.568-.563-2.133 0L.423 1.858c-.564.624-.564 1.561 0 2.123L6.51 10.04.423 16.034c-.564.562-.564 1.5 0 2.124l1.443 1.374c.565.624 1.506.624 2.133 0z"/></svg>
                        </span>
                    </span>
                </a>
            </li>
        {% else %}
            <li class="item next cursor-not-allowed opacity-50">
                <span class="size-8 lg:size-12 flex items-center justify-center">
                    <span class="sr-only">Next</span>
                    <span class="size-3.5 block">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="20" viewBox="0 0 13 20" class="w-full h-full object-contain"><path fill="currentColor" fill-rule="nonzero" d="M12.531 11.038c.565-.562.565-1.499 0-2.123L4 .422c-.627-.563-1.568-.563-2.133 0L.423 1.858c-.564.624-.564 1.561 0 2.123L6.51 10.04.423 16.034c-.564.562-.564 1.5 0 2.124l1.443 1.374c.565.624 1.506.624 2.133 0z"/></svg>
                    </span>
                </span>
            </li>
        {% endif %}
        {% if pagination.pages|last and pagination.pages|last.current != true %}
            <li class="item last hidden lg:block">
                <a href="{{ pagination.pages|last.link }}" class="size-8 lg:size-12 flex items-center justify-center">
                    <span class="sr-only">Last</span>
                    <span class="size-3.5 block">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="20" viewBox="0 0 25 20" class="w-full h-full object-contain"><path fill="currentColor" fill-rule="nonzero" d="M12.531 11.038c.565-.562.565-1.499 0-2.123L4 .422c-.627-.563-1.568-.563-2.133 0L.423 1.858c-.564.624-.564 1.561 0 2.123L6.51 10.04.423 16.034c-.564.562-.564 1.5 0 2.124l1.443 1.374c.565.624 1.506.624 2.133 0zm12.046-2.123L16.044.422c-.627-.563-1.568-.563-2.132 0l-1.443 1.436c-.565.562-.565 1.561 0 2.123l6.085 5.996-6.085 6.057c-.565.562-.565 1.5 0 2.124l1.443 1.374a1.45 1.45 0 0 0 2.132 0l8.533-8.494c.564-.562.564-1.499 0-2.123"/></svg>
                    </span>
                </a>
            </li>
        {% else %}
            <li class="item last cursor-not-allowed opacity-50 hidden lg:block">
                <span class="size-8 lg:size-12 flex items-center justify-center">
                    <span class="sr-only">Last</span>
                    <span class="size-3.5 block">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="20" viewBox="0 0 25 20" class="w-full h-full object-contain"><path fill="currentColor" fill-rule="nonzero" d="M12.531 11.038c.565-.562.565-1.499 0-2.123L4 .422c-.627-.563-1.568-.563-2.133 0L.423 1.858c-.564.624-.564 1.561 0 2.123L6.51 10.04.423 16.034c-.564.562-.564 1.5 0 2.124l1.443 1.374c.565.624 1.506.624 2.133 0zm12.046-2.123L16.044.422c-.627-.563-1.568-.563-2.132 0l-1.443 1.436c-.565.562-.565 1.561 0 2.123l6.085 5.996-6.085 6.057c-.565.562-.565 1.5 0 2.124l1.443 1.374a1.45 1.45 0 0 0 2.132 0l8.533-8.494c.564-.562.564-1.499 0-2.123"/></svg>
                    </span>
                </span>
            </li>
        {% endif %}
        </ul>
    </div>
{% endif %}

