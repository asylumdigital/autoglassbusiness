{% if posts.pagination.pages is not empty %}
    <div class="pagination">
        <ul class="pagination-links">
        {% if pagination.pages|first and pagination.pages|first.current != true %}
            <li class="item first">
                <a href="{{ pagination.pages|first.link }}">
                    <i class="fa fa-angle-double-left" aria-hidden="true"></i>
                    <span class="sr-only">First</span>
                </a>
            </li>
        {% else %}
            <li class="item first disabled">
                <i class="fa fa-angle-double-left" aria-hidden="true"></i>
                <span class="sr-only">First</span>
            </li>
        {% endif %}
        {% if pagination.prev %}
            <li class="item prev">
                <a href="{{ pagination.prev.link }}">
                    <i class="fa fa-angle-left" aria-hidden="true"></i>
                    <span class="sr-only">Previous</span>
                </a>
            </li>
        {% else %}
            <li class="item prev disabled">
                <i class="fa fa-angle-left" aria-hidden="true"></i>
                <span class="sr-only">Previous</span>
            </li>
        {% endif %}
        {% for page in pagination.pages %}
            {% if page.link %}
            <li class="item">
                <a href="{{ page.link }}" class="{{ page.class }}">{{ page.title }}</a>
            </li>
            {% elseif page.class == 'dots' %}
            <li class="separator">{{ page.title }}</li>
            {% else %}
            <li class="item current">{{ page.title }}</li>
            {% endif %}
        {% endfor %}

        {% if pagination.next %}
            <li class="item next">
                <a href="{{ pagination.next.link }}">
                    <span class="sr-only">Next</span>
                    <i class="fa fa-angle-right" aria-hidden="true"></i>
                </a>
            </li>
        {% else %}
            <li class="item next disabled">
                <span class="sr-only">Next</span>
                <i class="fa fa-angle-right" aria-hidden="true"></i>
            </li>
        {% endif %}
        {% if pagination.pages|last and pagination.pages|last.current != true %}
            <li class="item last">
                <a href="{{ pagination.pages|last.link }}">
                    <span class="sr-only">Last</span>
                    <i class="fa fa-angle-double-right" aria-hidden="true"></i>
                </a>
            </li>
        {% else %}
            <li class="item last disabled">
                <span class="sr-only">Last</span> <i class="fa fa-angle-double-right" aria-hidden="true"></i>
            </li>
        {% endif %}
        </ul>
    </div>
{% endif %}

