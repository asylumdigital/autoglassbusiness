<!doctype html>
<html lang="{{ site.language }}" class="scroll-smooth">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, minimum-scale=1, maximum-scale=1" />

        {# Fonts and preconnects are enqueued in Asylum\Theme\Enqueue\Enqueue #}
        {{ fn('wp_head') }}
    </head>
    <body class="overflow-x-clip {{ bodyClass }}" x-data="{ menu: false }">
        {% do action('wp_body_open') %}
        {% block header %}
            {% include 'modules/global/header.twig' %}
        {% endblock %}
        <main class="flex-1">
            {% block breadcrumb %}
                {% include 'components/breadcrumb.twig' %}
            {% endblock %}

            {% block content %}
                CONTENT
            {% endblock %}
        </main>

        {% block footer %}
            {% include "modules/global/footer.twig" %}
        {% endblock %}
        {{ fn('wp_footer') }}
    </body>
</html>
